# Meta-Governor API Configuration
# Copy this file to .env and fill in your values

# Azure AD / SharePoint App Registration
TENANT_ID="your-tenant-id-here"
CLIENT_ID="your-application-client-id-here"
CERT_THUMBPRINT="your-certificate-thumbprint-here"

# Certificate Path (relative to packages/api/src/)
CERT_PATH="../engine/certs/private.key"

# API Server Configuration
PORT=3002

# CORS Configuration
# For development: http://localhost:5173
# For production: https://your-deployed-dashboard.com
ALLOWED_ORIGIN=http://localhost:5173
